{
  "manifest_version": 3,
  "name": "T&C Guardian",
  "version": "1.0.0",
  "description": "AI-powered Terms and Conditions Guardian analyzing agreements and red flags.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}

